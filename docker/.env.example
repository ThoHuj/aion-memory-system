# Copy this file to docker/.env and adjust values for your environment.
# docker/.env is gitignored; never commit secrets.

# PostgreSQL role used by the database container.
POSTGRES_USER=aion

# PostgreSQL password for POSTGRES_USER. Change in production.
POSTGRES_PASSWORD=changeme

# Name of the PostgreSQL database created on first startup.
POSTGRES_DB=aion

# Async SQLAlchemy connection URL for the API (required at startup).
# Hostname "postgres" matches the Docker Compose service name.
DATABASE_URL=postgresql+asyncpg://aion:changeme@postgres:5432/aion

# Comma-separated list of allowed CORS origins for browser and agent clients.
CORS_ORIGINS=http://localhost:3000,http://localhost:8001

# API log level (e.g. debug, info, warning, error).
LOG_LEVEL=info

# Host address the API binds to inside the container.
API_HOST=0.0.0.0

# Port the API listens on inside the container.
API_PORT=8000
