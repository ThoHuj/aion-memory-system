# OpenRouter API key
OPENROUTER_API_KEY=# Your OpenRouter API key here

# Chat model for the MockAgent
OPENROUTER_CHAT_MODEL=# Your model here

# Extraction model for memory and fact extraction
OPENROUTER_EXTRACTION_MODEL=# Your extraction model here

# Embedding model (e.g. openai/text-embedding-3-small)
OPENROUTER_EMBEDDING_MODEL=# Your embedding model here

# Postgres (used by docker-compose.yml)
POSTGRES_USER=aion
POSTGRES_PASSWORD=# Your Postgres password here
POSTGRES_DB=aion

# Database connection URL used by the application
DATABASE_URL=postgresql://aion:<password>@localhost:5433/aion
